EXPO_PUBLIC_FIREBASE_API_KEY=your_api_key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
EXPO_PUBLIC_FIREBASE_APP_ID=your_app_id

# Single admin account (Firebase Console → Authentication → Email/Password).
# The user's UID must match firestore.rules (YOUR_ADMIN_UID_HERE).
EXPO_PUBLIC_ADMIN_EMAIL=admin@penny.ai
EXPO_PUBLIC_ADMIN_PASSWORD=your_super_strong_password

# Web OAuth client ID (Google Cloud Console → APIs & Credentials → OAuth 2.0 Client IDs → Web client).
# Same project as Firebase; used for Google sign-in on iOS, Android, and web (Expo opens the browser / ASWebAuthenticationSession).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_client_id.apps.googleusercontent.com
#
# Google Cloud → same Web client → Authorized JavaScript origins: add https://auth.expo.io
# (helps OAuth flows that bounce through Expo’s auth proxy in Expo Go).

# Optional: @your-expo-username/penny-ai for Expo Go (overrides @anonymous/penny-ai).
# In Google Cloud → Web client → Authorized redirect URIs, add the matching URL, e.g.:
#   https://auth.expo.io/@anonymous/penny-ai
#   https://auth.expo.io/@your-expo-username/penny-ai
# EXPO_PUBLIC_EXPO_PROJECT_FULL_NAME=@you/penny-ai
#
# Development build / standalone (expo-dev-client or store app): add the custom-scheme redirect
# Expo generates (scheme is app.json "scheme", e.g. pennyai). After first sign-in attempt, copy the
# redirect_uri from the Google error page if needed, or use: npx expo start --dev-client and log Linking.createURL('').
# Typical forms include pennyai:// or pennyai://expo-development-client/...
